# ESS-MAI repository hygiene
#
# Historical audits, validation reports, diffs, SHA manifests, and curated
# failure evidence are part of the project knowledge and are intentionally
# not ignored. Cargo.lock is also intentionally tracked for reproducibility.

# Rust / Cargo build output
/target/
**/target/
/debug/
**/*.rs.bk
**/mutants.out*/

# Native compiler and linker output
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.dSYM/

# Tauri-generated platform projects and local packaging output
**/src-tauri/gen/
**/src-tauri/target/
**/src-tauri/target-*/

# ui/dist is the declared Tauri frontendDist and belongs in the repository.
!ui/dist/
!ui/dist/**

# Frontend dependency and tool caches
node_modules/
**/node_modules/
.npm/
.pnpm-store/
.yarn/cache/
*.tsbuildinfo

# Local runtime state. Durable Negative Knowledge remains an ESS-MAI asset,
# but live vault/WAL/handoff data can contain machine- or user-specific data
# and must not be mixed with the source repository.
.essmai-runtime/
**/.essmai-runtime/
handoff/
**/handoff/
shadow_apupk_v*.wal
shadow_apupk_v*.lock
shadow_vault*.wal
wisdom_vault*.bin
light_project_request_*.bin
light_project_response_*.bin
quantum_project_request_*.bin
quantum_project_response_*.bin
shadow_request_*.bin
shadow_response_*.bin
old_ui_project_*.request
old_ui_project_*.response

# Local secrets and machine configuration
.env
.env.*
!.env.example
!.env.template

# Coverage, profiling, and test caches
coverage/
**/coverage/
lcov.info
*.profraw
*.profdata
.pytest_cache/
__pycache__/
*.py[cod]

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Crash dumps and transient files
*.dmp
*.tmp
*.temp
*.partial

