+            &activation_contract_digest.to_le_bytes(),
+            &created_at.to_le_bytes(),
+            b"GCL_PD_SPINE_PROCESS_V160",
+        ]);
+        Self { law_seal, system_laws_seal, phase_digest, process_digest }
+    }
+
+    pub fn verifies_for(
